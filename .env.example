# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Postgres) - see README for free hosting options
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# First admin account (used by prisma/seed.js — change these before seeding!)
ADMIN_NAME="Naija Pot Admin"
ADMIN_EMAIL="admin@naijapot.com"
ADMIN_PASSWORD="ChangeMe123!"
